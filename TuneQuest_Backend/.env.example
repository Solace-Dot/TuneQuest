# Django Configuration
SECRET_KEY='your-secret-key-here'
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Google Gemini AI API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Database Configuration
# Keep false to use SQLite (db.sqlite3), set true to enable PostgreSQL.
USE_POSTGRES=false
# Optional: Render will provide this automatically when PostgreSQL is attached.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_DB=tunequest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS origins for frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PayPal Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_CURRENCY=USD
PAYPAL_PREMIUM_PRICE=9.99

# Other API Keys (add as needed)
# OPENAI_API_KEY=your-openai-key-here
# STRIPE_SECRET_KEY=your-stripe-key-here