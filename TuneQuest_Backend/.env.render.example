DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_ALLOWED_HOSTS=tunequest-backend.onrender.com

CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend-project.vercel.app

# Render PostgreSQL connection string (recommended)
DATABASE_URL=postgresql://user:password@host:5432/tunequest
USE_POSTGRES=false

# Optional fallback Postgres vars (only used when DATABASE_URL is empty and USE_POSTGRES=true)
POSTGRES_DB=tunequest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_SECRET=replace-with-paypal-secret
PAYPAL_CURRENCY=USD
PAYPAL_PREMIUM_PRICE=9.99

GEMINI_API_KEY=replace-with-gemini-api-key
